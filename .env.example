# Copiar a .env (cp .env.example .env). Valores locales de desarrollo, no secretos reales.

# MinIO (lakehouse: bronze / silver / gold)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# ClickHouse (capa de servicio / OLAP)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=spotify
CLICKHOUSE_PASSWORD=spotify123
CLICKHOUSE_DB=spotify

# Kafka (replay en "tiempo real" — perfil streaming)
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_PLAYS=spotify.plays
# Factor de aceleración del replay: 3600 = 1 hora de historia por segundo real
REPLAY_SPEEDUP=3600

# Zona horaria por defecto para convertir ts (UTC) a hora local
DEFAULT_TZ=America/Mexico_City
